{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. 前端不直接调用 Tauri fs/shell API，统一走自定义 commands（更安全）。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard-manager:default",
    "dialog:default",
    {
      "identifier": "shell:allow-open",
      "allow": [{ "name": "open", "cmd": null, "args": true }]
    },
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    }
  ]
}